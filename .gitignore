# .gitignore — WHY: keeps personal/local Claude Code files and build junk out of git.
# Assessment topic: storage levels — "local" level files (CLAUDE.local.md,
# .claude/settings.local.json) are personal and must NOT be committed.

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Claude Code LOCAL level (personal, per machine) — only the *.example files are committed
CLAUDE.local.md
.claude/settings.local.json

# Sub-agent hand-off files are run artifacts, regenerated by /review-parallel
.agent-handoff/

# Real secrets would go here; the demo key is FAKE and committed on purpose
.env
